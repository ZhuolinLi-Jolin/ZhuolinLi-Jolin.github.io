{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 260,
  "height": 180,
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "background": "#fefdfb",
  "padding": 20,
  "title": {
    "text": "Inflation, consumer prices (annual %)",
    "subtitle": "Source: World Bank",
    "anchor": "start",
    "fontSize": 10,
    "subtitleFontSize": 8,
    "font": "sans-serif"
  },
  "data": {
    "values": [
      {"date": "2017-01-01", "value": 0.1},
      {"date": "2018-01-01", "value": 0.2},
      {"date": "2019-01-01", "value": 0.5},
      {"date": "2020-01-01", "value": 0.6}
    ]
  },
  "transform": [
    {
      "filter": "year(datum.date) >= 2011"
    }
  ],
  "mark": {
    "type": "line",
    "point": false,
    "strokeWidth": 1.5,
    "color": "#3d5a47",
    "interpolate": "linear"
  },
  "encoding": {
    "x": {
      "field": "date",
      "type": "temporal",
      "title": null,
      "axis": {
        "format": "%Y",
        "tickCount": "year",
        "labelFontSize": 8,
        "grid": false
      }
    },
    "y": {
      "field": "value",
      "type": "quantitative",
      "title": "value",
      "axis": {
        "labelFontSize": 8,
        "titleFontSize": 9,
        "gridColor": "#e8e6e1",
        "gridDash": [4, 4]
      }
    },
    "tooltip": [
      {"field": "date", "type": "temporal", "title": "Date", "format": "%Y"},
      {"field": "value", "type": "quantitative", "title": "Value", "format": ".2f"}
    ]
  },
  "config": {
    "view": {"stroke": "transparent"},
    "axis": {
      "labelFont": "sans-serif",
      "titleFont": "sans-serif"
    },
    "legend": {
      "labelFontSize": 8,
      "titleFontSize": 9
    }
  }
}