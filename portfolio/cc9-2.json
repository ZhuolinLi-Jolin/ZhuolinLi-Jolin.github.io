{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Separation Rates by AI Exposure and Age Group with ChatGPT release annotation",
  "width": 500,
  "height": 300,
  "background": "#fefdfb",
  "padding": 20,
  "title": {
    "text": "Separation Rates by AI Exposure and Age Group",
    "subtitle": "Source: Integrated Public Use Microdata Series Current Population Survey",
    "anchor": "middle",
    "fontSize": 16,
    "font": "sans-serif",
    "subtitleFontStyle": "italic",
    "subtitleFontSize": 12,
    "subtitleColor": "#666",
    "subtitlePadding": 10
  },
  "data": {
    "url": "https://gist.githubusercontent.com/ZhuolinLi-Jolin/2879c87bbbe77593c06b6b760629f186/raw/ca4bcba597af6f1f408086e289805587a168bc92/separation.csv", 
    "format": {"type": "csv"}
  },
  "layer": [
    {
      "description": "Vertical line for ChatGPT release",
      "data": {"values": [{"Date": "2022-11-30"}]},
      "mark": {
        "type": "rule",
        "color": "black",
        "strokeDash": [4, 4],
        "size": 1.5
      },
      "encoding": {
        "x": {"field": "Date", "type": "temporal"}
      }
    },
    {
      "description": "Text label for ChatGPT release",
      "data": {"values": [{"Date": "2022-11-01", "Label": "ChatGPT release"}]},
      "mark": {
        "type": "text",
        "align": "right",
        "dx": 85,
        "dy": -70,
        "baseline": "top",
        "fontStyle": "italic",
        "fontSize": 10
      },
      "encoding": {
        "x": {"field": "Date", "type": "temporal"},
        "text": {"field": "Label"}
      }
    },
    {
      "description": "Main line charts",
      "transform": [
        {
          "fold": ["Eai1_ma1", "Eai3_ma1", "Eai1_ma2", "Eai3_ma2"],
          "as": ["Group", "Value"]
        },
        {
          "calculate": "datum.Group == 'Eai1_ma1' ? 'High AI Exposure (20-24)' : datum.Group == 'Eai3_ma1' ? 'Low AI Exposure (20-24)' : datum.Group == 'Eai1_ma2' ? 'High AI Exposure (25-55)' : 'Low AI Exposure (25-55)'",
          "as": "GroupLabel"
        }
      ],
      "mark": {
        "type": "line",
        "strokeWidth": 2.5,
        "interpolate": "linear"
      },
      "params": [
        {
          "name": "highlight",
          "select": {"type": "point", "fields": ["Group"]},
          "bind": "legend"
        }
      ],
      "encoding": {
        "x": {
          "field": "Date",
          "type": "temporal",
          "axis": {
            "title": "Year",
            "grid": false,
            "format": "%Y",
            "tickCount": 6,
            "labelFlush": true
          }
        },
        "y": {
          "field": "Value",
          "type": "quantitative",
          "axis": {
            "title": "Separation Rate (%)",
            "gridColor": "#e8e6e1",
            "gridDash": [4, 4],
            "domain": false
          }
        },
        "color": {
          "field": "Group",
          "type": "nominal",
          "scale": {
            "domain": ["Eai1_ma1", "Eai3_ma1", "Eai1_ma2", "Eai3_ma2"],
            "range": ["#c7e9c0", "#00441b", "#fddbc7", "#7f2704"]
          },
          "legend": {
            "orient": "right",
            "title": null,
            "labelFontSize": 11,
            "symbolType": "stroke",
            "offset": 10,
            "labelExpr": "{'Eai1_ma1': 'High AI Exposure (20-24)', 'Eai3_ma1': 'Low AI Exposure (20-24)', 'Eai1_ma2': 'High AI Exposure (25-55)', 'Eai3_ma2': 'Low AI Exposure (25-55)'}[datum.label]"
          }
        },
        "opacity": {
          "condition": {"param": "highlight", "value": 1},
          "value": 0.01
        },
        "tooltip": [
          {"field": "Date", "type": "temporal", "title": "Date", "format": "%Y-%m"},
          {"field": "GroupLabel", "type": "nominal", "title": "Group"},
          {"field": "Value", "type": "quantitative", "title": "Rate", "format": ".4f"}
        ]
      }
    }
  ],
  "config": {
    "view": {"stroke": "transparent"},
    "axis": {
      "labelFont": "sans-serif",
      "titleFont": "sans-serif",
      "titleFontSize": 12,
      "titleFontWeight": "normal"
    }
  }
}